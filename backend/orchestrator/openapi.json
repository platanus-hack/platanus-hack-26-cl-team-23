        "type": "object",
        "required": [
          "t",
          "hist"
        ],
        "title": "ZoneFeaturesInput",
        "description": "Features de un frame. `desc` y la curvatura son opcionales: basta con enviarlos cada\n~0,5 s; `hist` hace falta en todos los frames para detectar cortes."
      },
      "ZoneFeaturesResponse": {
        "properties": {
          "frames": {
            "items": {
              "$ref": "#/components/schemas/ZoneFeatures"
            },
            "type": "array",
            "title": "Frames"
          }
        },
        "type": "object",
        "required": [
          "frames"
        ],
        "title": "ZoneFeaturesResponse"
      },
      "ZoneFrame": {
        "properties": {
          "frame": {
            "type": "integer",
            "title": "Frame",
            "description": "Posici\u00f3n en la lista enviada (igual que 'frame' de /track)"
          },
          "t": {
            "type": "number",
            "title": "T"
          },
          "zone": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 1.0,
            "title": "Zone",
            "description": "Zona que enfoca la c\u00e1mara, con hist\u00e9resis"
          },
          "p": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "P",
            "description": "P(Z1..Z6)"
          },
          "s": {
            "type": "number",
            "title": "S",
            "description": "Metros desde la meta del punto enfocado (0-400)"
          },
          "x": {
            "type": "number",
            "title": "X",
            "description": "Metros recorridos desde la salida por el punto enfocado"
          },
          "x_std": {
            "type": "number",
            "title": "X Std"
          },
          "v": {
            "type": "number",
            "title": "V",
            "description": "Velocidad del punto enfocado (m/s)"
          },
          "cut": {
            "type": "boolean",
            "title": "Cut",
            "description": "True si este frame empieza un plano nuevo"
          },
          "recognized": {
            "type": "boolean",
            "title": "Recognized",
            "description": "True si la memoria de c\u00e1maras reconoci\u00f3 el encuadre"
          }
        },
        "type": "object",
        "required": [
          "frame",
          "t",
          "zone",
          "p",
          "s",
          "x",
          "x_std",
          "v",
          "cut",
          "recognized"
        ],
        "title": "ZoneFrame"
      },
      "ZonesRequest": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source",
            "default": "upload"
          },
          "distance": {
            "type": "number",
            "maximum": 10000.0,
            "exclusiveMinimum": 0.0,
            "title": "Distance",
            "description": "Metros de la prueba (define salida y ritmo)",
            "default": 1500
          },
          "t0": {
            "type": "number",
            "minimum": 0.0,
            "title": "T0",
            "description": "Segundo del video en que suena el disparo (reloj de carrera)",
            "default": 0.0
          },
          "seed": {
            "type": "integer",
            "title": "Seed",
            "default": 0
          },
          "cut_threshold": {
            "type": "number",
            "exclusiveMaximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Cut Threshold",
            "default": 0.19
          },
          "frames": {
            "items": {
              "$ref": "#/components/schemas/ZoneFeaturesInput"
            },
            "type": "array",
            "maxItems": 6000,
            "minItems": 1,
            "title": "Frames"
          }
        },
        "type": "object",
        "required": [
          "frames"
        ],
        "title": "ZonesRequest"
      },
      "ZonesResult": {
        "properties": {
          "distance": {
            "type": "number",
            "title": "Distance"
          },
          "t0": {
            "type": "number",
            "title": "T0"
          },
          "zone_names": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Zone Names"
          },
          "cuts": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Cuts"
          },
          "frames": {
            "items": {
              "$ref": "#/components/schemas/ZoneFrame"
            },
            "type": "array",
            "title": "Frames"
          }
        },
        "type": "object",
        "required": [
          "distance",
          "t0",
          "zone_names",
          "cuts",
          "frames"
        ],
        "title": "ZonesResult"
      }
    }
  }
