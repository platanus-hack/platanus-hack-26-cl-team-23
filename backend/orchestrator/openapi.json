                  "$ref": "#/components/schemas/ZoneFeaturesResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/zones/": {
      "post": {
        "tags": [
          "zones"
        ],
        "summary": "Zones",
        "description": "En qu\u00e9 zona (Z1..Z6) de la pista enfoca la c\u00e1mara en cada frame.",
        "operationId": "zones_api_zones__post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ZonesRequest"
              }
