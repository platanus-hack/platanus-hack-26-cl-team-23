# Runtime
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8080

# Cliente HTTP
HTTP_TIMEOUT=40

# Roboflow (https://app.roboflow.com/settings/api -> API Keys)
ROBOFLOW_API_KEY=
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_MODEL_ID=rfdetr-medium

# Vercel Blob (store publico). En Vercel el token OIDC llega solo; en local usa
# `vercel link` + `vercel env pull` o define BLOB_READ_WRITE_TOKEN. Sin credenciales
# el almacenamiento cae a disco local (STORAGE_BACKEND=auto).
BLOB_STORE_ID=store_ctdy1E8HLuHnvfzd
BLOB_ACCESS=public
BLOB_WEBHOOK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAXdYzmMlSih9eU7GxXpC08w9+5HOPPIFIbVviv6FHdHQ=\n-----END PUBLIC KEY-----"
STORAGE_BACKEND=auto

# Relato de la carrera (opcional). Sin estas claves /api/narration devuelve solo el texto,
# armado con plantillas deterministas: la demo nunca se queda muda.
# Claude escribe el guion a partir de una hoja de hechos; ElevenLabs lo lee.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ELEVEN_LABS_API_KEY=
# Voz en español de Chile. El default es "Cristian Cornejo" (hombre, tono seguro), de la
# Voice Library: la API no deja usar voces de la librería en el plan gratis.
# Otras chilenas: Edgar 6ZDFxWiAykFxCoe683WK (calmo), Vicente 6WgXEzo1HGn3i7ilT4Fh (joven),
# Ignacio NDx3GTwfaeouBvRv4NrB (neutro, pausado). Con una cuenta gratis: 21m00Tcm4TlvDq8ikWAM.
ELEVEN_LABS_VOICE_ID=ClNifCEVq1smkl4M3aTk
# eleven_v4 habla más rápido que v2: la voz cabe mejor en el clip.
ELEVEN_LABS_MODEL=eleven_v4

# Control de gasto de Roboflow (opcional). Si se define, /detect y /process exigen
# el header X-Demo-Key con este valor.
DEMO_ACCESS_KEY=
